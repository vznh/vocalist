{
  "name": "vocalist",
  "productName": "Music for the Masses",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first karaoke room with independent lyrics and transcription.",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build-native.mjs && tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "setup:audio": "node scripts/setup-audio.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:reprocessing": "npm run build && node scripts/reprocessing-smoke.mjs",
    "test:persistence": "npm run build && node scripts/persistence-smoke.mjs",
    "test:playback": "npm run build && node scripts/playback-smoke.mjs",
    "test:export": "npm run build && node scripts/export-smoke.mjs",
    "package": "node scripts/record-source.mjs && npm run build && electron-builder --mac --dir",
    "test:audio": "node scripts/verify-audio.mjs"
  },
  "build": {
    "appId": "app.norae.desktop",
    "productName": "Music for the Masses",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": ".runtime/native/norae-metadata",
        "to": "native/norae-metadata"
      },
      {
        "from": "build",
        "to": "build"
      },
      {
        "from": ".runtime/source.json",
        "to": "source.json"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dialkit": "^2.2.1",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "motion": "^14.14.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
